{
  "id": "synthetic-legal-eval-conformance-001",
  "name": "NORA Conformance Legal Citation and Treatment Evaluation Suite",
  "version": "1.0.0",
  "target_project": "nora-legal-research",
  "description": "Completely independent synthetic evaluation fixture designed from scratch to verify citation normalization and adverse treatment warnings against conformance specifications.",
  "cases": [
    {
      "id": "CONF-LEG-001",
      "category": "legal-citation",
      "prompt": "Verify citation normalization for 347 U.S. 483",
      "context": {
        "mock_locators": ["reporter://us/347/483"],
        "mock_unsupported_flagged": false
      },
      "expected_output": null,
      "assertions": [
        {
          "scorer": "provenance",
          "expected": "reporter://us/347/483",
          "weight": 1.0
        }
      ]
    },
    {
      "id": "CONF-LEG-002",
      "category": "treatment-warning",
      "prompt": "Retrieve treatment warning for synthetic case 500 F.3d 100",
      "context": {
        "mock_retrieved_items": ["SYNTHETIC-CASE-500-F3D-100", "WARNING-OVERRULED-BY-SUPREME-COURT"]
      },
      "expected_output": null,
      "assertions": [
        {
          "scorer": "contradiction",
          "expected": "WARNING-OVERRULED-BY-SUPREME-COURT",
          "weight": 1.0
        }
      ]
    }
  ]
}
